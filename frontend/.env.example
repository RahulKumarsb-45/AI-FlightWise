# ==========================
# AI FLIGHTWISE FRONTEND CONFIGURATION
# ==========================
# Base URL for the Express backend API
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Canonical site URL for metadata, sitemaps, and robots.txt
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: Sentry DSN for client/server error monitoring
NEXT_PUBLIC_SENTRY_DSN=

# Optional: Enable A/B product experimentation (default: true)
NEXT_PUBLIC_ENABLE_EXPERIMENTS=true

